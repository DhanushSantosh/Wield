{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wield",
  "version": "0.1.0",
  "identifier": "io.github.DhanushSantosh.Wield",
  "build": {
    "beforeDevCommand": "npm run dev:ui -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "palette",
        "title": "Wield",
        "width": 520,
        "height": 480,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "preferences",
        "title": "Wield Preferences",
        "width": 640,
        "height": 480,
        "resizable": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "category": "Utility",
    "shortDescription": "Portal-native Linux utility hub",
    "longDescription": "A command palette and tray for quick Linux actions and file conversions."
  }
}
