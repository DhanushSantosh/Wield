  {
    "id": "document.convert",
    "title": "Convert document",
    "keywords": [
      "document",
      "convert",
      "pandoc",
      "libreoffice",
      "pdf",
      "docx",
      "odt",
      "markdown"
    ],
    "category": "Convert",
    "args": [
      {
        "name": "input",
        "label": "Document",
        "help": null,
        "arg_type": {
          "File": {
            "filters": [
              {
                "label": "Documents",
                "extensions": [
                  "md",
                  "html",
                  "docx",
                  "odt",
                  "rst"
                ]
              }
            ],
            "multiple": true
          }
        },
        "default": null,
        "required": true,
        "when": null
      },
      {
        "name": "format",
        "label": "Output format",
        "help": null,
        "arg_type": {
          "Enum": {
            "options": [
              "md",
              "html",
              "docx",
              "odt",
              "pdf"
            ]
          }
        },
        "default": {
          "Str": "md"
        },
        "required": true,
        "when": null
      }
    ],
    "requires": {
      "Binary": "pandoc"
    },
    "output": {
      "File": {
        "name": "{input_stem}.{format}",
        "dir": "SameAsInput"
      }
    },
    "capability": {
      "Command": {
        "binary": "sh",
        "args": [
          {
            "template": "-c",
            "when": null
          },
          {
            "template": "set -e\nin=\"$1\"; out=\"$2\"; fmt=\"$3\"\ncase \"$fmt\" in\n  pdf)\n    dir=$(dirname \"$out\")\n    stem=$(basename \"$out\" \".$fmt\")\n    ext=$(printf \"%s\" \"$in\" | sed \"s/^.*\\.//\")\n    tmp=\"$dir/$stem.$ext\"\n    trap \"rm -f \\\"$tmp\\\"\" EXIT\n    cp \"$in\" \"$tmp\"\n    soffice --headless --convert-to pdf --outdir \"$dir\" \"$tmp\" 1>&2\n    ;;\n  *)\n    pandoc --standalone \"$in\" -o \"$out\"\n    ;;\nesac\n",
            "when": null
          },
          {
            "template": "sh",
            "when": null
          },
          {
            "template": "{input}",
            "when": null
          },
          {
            "template": "{output}",
            "when": null
          },
          {
            "template": "{format}",
            "when": null
          }
        ],
        "progress": "None",
        "timeout": 300,
        "success": "ExitZero"
      }
    }
  },
  {
    "id": "image.convert",
    "title": "Convert image",
    "keywords": [
      "image",
      "convert",
      "resize",
      "compress",
      "png",
      "jpeg",
      "webp",
      "format"
    ],
    "category": "Convert",
    "args": [
      {
        "name": "input",
        "label": "Image",
        "help": null,
        "arg_type": {
          "File": {
            "filters": [
              {
                "label": "Images",
                "extensions": [
                  "png",
                  "jpg",
                  "jpeg",
                  "webp",
                  "gif",
                  "bmp",
                  "tiff",
                  "avif"
                ]
              }
            ],
            "multiple": false
          }
        },
        "default": null,
        "required": true,
        "when": null
      },
      {
        "name": "format",
        "label": "Output format",
        "help": null,
        "arg_type": {
          "Enum": {
            "options": [
              "png",
              "jpg",
              "webp",
              "gif",
              "bmp",
              "tiff",
              "avif"
            ]
          }
        },
        "default": {
          "Str": "png"
        },
        "required": true,
        "when": null
      },
      {
        "name": "width",
        "label": "Width (px)",
        "help": "Resize to this width, keeping aspect ratio. Leave blank to keep the original size.",
        "arg_type": {
          "Int": {
            "range": [
              1,
              20000
            ],
            "step": 1
          }
        },
        "default": null,
        "required": false,
        "when": null
      },
      {
        "name": "quality",
        "label": "Quality",
        "help": "Compression quality for lossy formats (JPEG, WebP, AVIF). Leave blank for the format default.",
        "arg_type": {
          "Int": {
            "range": [
              1,
              100
            ],
            "step": 1
          }
        },
        "default": null,
        "required": false,
        "when": null
      }
    ],
    "requires": {
      "Binary": "magick"
    },
    "output": {
      "File": {
        "name": "{input_stem}.{format}",
        "dir": "SameAsInput"
      }
    },
    "capability": {
      "Command": {
        "binary": "magick",
        "args": [
          {
            "template": "{input}",
            "when": null
          },
          {
            "template": "-resize",
            "when": {
              "arg": "width",
              "in": []
            }
          },
          {
            "template": "{width}x",
            "when": {
              "arg": "width",
              "in": []
            }
          },
          {
            "template": "-quality",
            "when": {
              "arg": "quality",
              "in": []
            }
          },
          {
            "template": "{quality}",
            "when": {
              "arg": "quality",
              "in": []
            }
          },
          {
            "template": "{output}",
            "when": null
          }
        ],
        "progress": "None",
        "timeout": 120,
        "success": "ExitZero"
      }
    }
  },
  {
    "id": "video.convert",
    "title": "Convert video",
    "keywords": [
      "video",
      "convert",
      "ffmpeg",
      "mp4",
      "webm",
      "mkv",
      "resolution",
      "format"
    ],
    "category": "Convert",
    "args": [
      {
        "name": "input",
        "label": "Video",
        "help": null,
        "arg_type": {
          "File": {
            "filters": [
              {
                "label": "Videos",
                "extensions": [
                  "mp4",
                  "mov",
                  "mkv",
                  "webm",
                  "avi"
                ]
              }
            ],
            "multiple": true
          }
        },
        "default": null,
        "required": true,
        "when": null
      },
      {
        "name": "format",
        "label": "Output format",
        "help": null,
        "arg_type": {
          "Enum": {
            "options": [
              "mp4",
              "webm",
              "mkv"
            ]
          }
        },
        "default": {
          "Str": "mp4"
        },
        "required": true,
        "when": null
      },
      {
        "name": "resolution",
        "label": "Resolution",
        "help": "\"original\" keeps the source resolution unchanged.",
        "arg_type": {
          "Enum": {
            "options": [
              "original",
              "1080p",
              "720p",
              "480p"
            ]
          }
        },
        "default": {
          "Str": "original"
        },
        "required": true,
        "when": null
      },
      {
        "name": "quality",
        "label": "Quality (CRF)",
        "help": "Lower is higher quality (libx264's CRF scale - the opposite of most \"quality\" sliders). Leave blank for ffmpeg's own default.",
        "arg_type": {
          "Int": {
            "range": [
              0,
              51
            ],
            "step": 1
          }
        },
        "default": null,
        "required": false,
        "when": null
      }
    ],
    "requires": {
      "Binary": "ffmpeg"
    },
    "output": {
      "File": {
        "name": "{input_stem}.{format}",
        "dir": "SameAsInput"
      }
    },
    "capability": {
      "Command": {
        "binary": "ffmpeg",
        "args": [
          {
            "template": "-y",
            "when": null
          },
          {
            "template": "-i",
            "when": null
          },
          {
            "template": "{input}",
            "when": null
          },
          {
            "template": "-vf",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "1080p"
                }
              ]
            }
          },
          {
            "template": "scale=-2:1080",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "1080p"
                }
              ]
            }
          },
          {
            "template": "-vf",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "720p"
                }
              ]
            }
          },
          {
            "template": "scale=-2:720",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "720p"
                }
              ]
            }
          },
          {
            "template": "-vf",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "480p"
                }
              ]
            }
          },
          {
            "template": "scale=-2:480",
            "when": {
              "arg": "resolution",
              "in": [
                {
                  "Str": "480p"
                }
              ]
            }
          },
          {
            "template": "-crf",
            "when": {
              "arg": "quality",
              "in": []
            }
          },
          {
            "template": "{quality}",
            "when": {
              "arg": "quality",
              "in": []
            }
          },
          {
            "template": "-progress",
            "when": null
          },
          {
            "template": "pipe:2",
            "when": null
          },
          {
            "template": "-nostats",
            "when": null
          },
          {
            "template": "{output}",
            "when": null
          }
        ],
        "progress": "FfmpegDuration",
        "timeout": 1800,
        "success": "ExitZero"
      }
    }
  }
]